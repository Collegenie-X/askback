            { "id": "l8", "type": "notice", "text": "🤝 동점! 재투표가 필요해", "tone": "warn", "showIf": { "key": "a", "op": "==", "value": 8 } },
            { "id": "l9", "type": "button", "text": "🔄 다시 하기", "go": "vote", "rule": "R4", "do": [{ "key": "a", "op": "set", "value": 0 }, { "key": "b", "op": "set", "value": 0 }, { "key": "voted", "op": "set", "value": 0 }] },
            { "id": "l10", "type": "button", "text": "↩️ 돌아가기", "go": "vote" }
