            { "id": "l2", "type": "button", "text": "🍗 치킨마요", "rule": "R1", "do": [{ "key": "a", "op": "add", "value": 1 }, { "key": "voted", "op": "set", "value": 1 }], "disabledIf": { "key": "voted", "op": "==", "value": 1 } },
            { "id": "l3", "type": "button", "text": "🍜 짜장면", "rule": "R1", "do": [{ "key": "b", "op": "add", "value": 1 }, { "key": "voted", "op": "set", "value": 1 }], "disabledIf": { "key": "voted", "op": "==", "value": 1 } },
            { "id": "l4", "type": "notice", "text": "✅ 투표 완료! 이제 결과를 볼 수 있어", "tone": "good", "showIf": { "key": "voted", "op": "==", "value": 1 } },
