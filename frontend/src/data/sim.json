            { "id": "p3", "type": "notice", "text": "😵 목말라요! 물을 주세요", "tone": "warn", "showIf": { "key": "moisture", "op": "<", "value": 30 } },
            { "id": "p4", "type": "notice", "text": "😌 지금은 충분해요", "tone": "good", "showIf": { "key": "moisture", "op": ">=", "value": 80 } },
            { "id": "p5", "type": "button", "text": "🚿 물 주기", "go": "watering", "rule": "R3", "disabledIf": { "key": "moisture", "op": ">=", "value": 80 } },
