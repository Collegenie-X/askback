            { "id": "p12", "type": "button", "text": "🧹 기록 지우기", "rule": "R4", "do": [{ "key": "watered", "op": "set", "value": 0 }] },
            { "id": "p13", "type": "button", "text": "🏠 처음으로", "go": "home" }
          ]
        }
      ]
    },
