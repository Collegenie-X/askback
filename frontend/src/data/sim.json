          "blocks": [
            { "id": "p7", "type": "text", "text": "물을 주고 있어요… 지금 습도 {moisture}%" },
            { "id": "p8", "type": "button", "text": "✅ 다 줬어", "go": "home", "rule": "R2", "do": [{ "key": "moisture", "op": "add", "value": 30 }, { "key": "watered", "op": "add", "value": 1 }] },
            { "id": "p9", "type": "button", "text": "↩️ 취소", "go": "home" }
          ]
        },
        {
