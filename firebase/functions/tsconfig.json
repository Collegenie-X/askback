{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@front/*": ["../../frontend/src/*"],
      "@/*": ["../../frontend/src/*"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src"]
}
