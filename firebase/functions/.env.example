# functions/.env 로 복사해서 씁니다 (배포 때 함께 올라갑니다 — 비밀값은 넣지 마세요).
# 로컬 에뮬레이터에서만 다른 값을 쓰려면 .env.local 에 적습니다.

# Firebase 콘솔 → 프로젝트 설정 → 웹 API 키 (로그인 · 토큰 갱신에 필요, 공개돼도 되는 값)
WEB_API_KEY=

# 가입할 때 자동으로 관리자가 되는 이메일 (쉼표로 여러 개)
ADMIN_EMAILS=

# 브라우저 앱 주소 (쉼표로 여러 개, * 는 전부 허용)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 함수 지역 (기본 서울)
# FUNCTION_REGION=asia-northeast3

# 처음 기본 모델 — 이후에는 관리자 API(PATCH /v1/admin/settings/llm)로 바꾼다
# ASKBACK_MODEL=claude-opus-5-5
ASKBACK_EFFORT=low
