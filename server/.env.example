# server/.env 로 복사해서 씁니다. .env 는 git 에 올리지 않습니다.

# ---- Django ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# ASKBACK_SQLITE_PATH=/절대/경로/db.sqlite3     # 기본: server/db.sqlite3

# ---- Claude ----
# 키가 없으면 로컬 답 카드(frontend/public/answers)로 답합니다.
ANTHROPIC_API_KEY=
ASKBACK_LLM_ENABLED=1
ASKBACK_LLM_FALLBACKS=1          # 거절 시 서버 측 대체 모델 (fallbacks: "default")
ASKBACK_MODEL=claude-opus-5-5    # 작업별로 덮어쓰기: ASKBACK_MODEL_ANSWER / _RQ / _FEEDBACK / _DEEP
ASKBACK_EFFORT_ANSWER=medium
ASKBACK_EFFORT_RQ=low
ASKBACK_EFFORT_FEEDBACK=low
ASKBACK_EFFORT_DEEP=low
ASKBACK_TIMEOUT_ANSWER=45
ASKBACK_TIMEOUT_SHORT=15

# ---- 한도 ----
ASKBACK_DAILY_TURN_LIMIT=60
ASKBACK_RATE_TURNS=10/min
ASKBACK_RATE_DEVICE=20/hour

# ---- 브라우저 앱 ----
ASKBACK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- 더미 DB (python manage.py seed_dummy --admin) ----
# 개발 관리자 비밀번호. 비우면 askback-dev-1234
# ASKBACK_DUMMY_ADMIN_PASSWORD=

# ---- 코칭 데이터 위치 (기본: 같은 저장소의 frontend) ----
# ASKBACK_DATA_DIR=../frontend/src/data
# ASKBACK_ANSWERS_DIR=../frontend/public/answers
